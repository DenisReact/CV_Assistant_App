generator client {
  provider = "prisma-client"
  moduleFormat = "cjs"
  output = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    String @id @default(uuid()) @db.Uuid
  email String @unique

  documents Document[]
  sessions  ChatSession[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}

enum DocumentKind {
  RESUME
  JOB_DESCRIPTION

  @@map("document_kind")
}

enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED

  @@map("document_status")
}

/// An uploaded resume or job description, plus its ingestion state.
model Document {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind  DocumentKind
  title String

  rawText String @map("raw_text")

  status DocumentStatus @default(PENDING)

  error String?

  chunkCount Int @default(0) @map("chunk_count")

  sourceFilename String? @map("source_filename")
  byteSize       Int?    @map("byte_size")

  chunks Chunk[]

  sessionsAsResume ChatSession[]    @relation("SessionResume")
  sessionJobs      ChatSessionJob[]
  fitAsResume      FitAnalysis[]    @relation("FitResume")
  fitAsJob         FitAnalysis[]    @relation("FitJob")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, kind, status])
  @@map("documents")
}

model Chunk {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  chunkIndex Int @map("chunk_index")

  content String

  tokenCount Int @map("token_count")

  embedding Unsupported("vector(768)")?

  /// Which model produced `embedding`. Cosine similarity across two different
  /// models still returns a number, it just means nothing — recording the model
  /// makes a re-embed migration possible instead of a wipe.
  embeddingModel String? @map("embedding_model")

  citations Citation[]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@map("chunks")
}

enum MessageRole {
  USER
  ASSISTANT

  @@map("message_role")
}

model ChatSession {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  resumeId String?   @map("resume_id") @db.Uuid
  resume   Document? @relation("SessionResume", fields: [resumeId], references: [id], onDelete: SetNull)

  title String?

  jobs     ChatSessionJob[]
  messages Message[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, updatedAt])
  @@map("chat_sessions")
}

/// A job description in scope for a session.
model ChatSessionJob {
  sessionId String      @map("session_id") @db.Uuid
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  documentId String   @map("document_id") @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  label Int

  createdAt DateTime @default(now()) @map("created_at")

  @@id([sessionId, documentId])
  @@unique([sessionId, label])
  @@map("chat_session_jobs")
}

model Message {
  id String @id @default(uuid()) @db.Uuid

  sessionId String      @map("session_id") @db.Uuid
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  role    MessageRole
  content String

  citations Citation[]

  model            String?
  promptTokens     Int?    @map("prompt_tokens")
  completionTokens Int?    @map("completion_tokens")
  latencyMs        Int?    @map("latency_ms")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([sessionId, createdAt])
  @@map("messages")
}

model Citation {
  messageId String  @map("message_id") @db.Uuid
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  chunkId String @map("chunk_id") @db.Uuid
  chunk   Chunk  @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  rank  Int
  score Float

  @@id([messageId, chunkId])
  @@map("citations")
}

model FitAnalysis {
  id String @id @default(uuid()) @db.Uuid

  resumeId String   @map("resume_id") @db.Uuid
  resume   Document @relation("FitResume", fields: [resumeId], references: [id], onDelete: Cascade)

  jobId String   @map("job_id") @db.Uuid
  job   Document @relation("FitJob", fields: [jobId], references: [id], onDelete: Cascade)

  overallScore Int @map("overall_score")

  breakdown Json

  model String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([resumeId, jobId])
  @@map("fit_analyses")
}
