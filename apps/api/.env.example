# Database variables.
DATABASE_URL="postgresql://cia:cia_local_dev@localhost:5433/cia?schema=public"

NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173

# Embeddings and generation both run on Gemini — one key, one provider.
# https://aistudio.google.com/apikey (free tier is enough)
GEMINI_API_KEY=...

# Optional overrides. The embedding model is pinned to 768 output dimensions to
# match the vector(768) column; changing the model means a migration and a
# re-embed of every chunk.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-2.5-flash
